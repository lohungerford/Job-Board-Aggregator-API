# Database (Neon / local Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobboard

# Redis (Upstash / local). Leave empty to disable rate limiting in local dev.
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Internal cron endpoint
INTERNAL_INGEST_SECRET=replace-with-a-long-random-ingest-secret

# App
APP_ENV=development
CORS_ALLOW_ORIGINS=*
